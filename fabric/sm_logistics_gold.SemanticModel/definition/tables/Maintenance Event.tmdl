/// One row per maintenance record, with labor and parts cost and downtime.
table 'Maintenance Event'
	lineageTag: 74749e99-ccc2-42c4-822f-da626451b170
	sourceLineageTag: [fact].[fact_maintenance]

	/// Count of maintenance records. Answers MA-1.
	measure 'Maintenance Events' = CALCULATE ( COUNTROWS ( 'Maintenance Event' ), 'Maintenance Event'[is_deleted_in_source] = FALSE () )
		formatString: #,0
		displayFolder: Maintenance
		lineageTag: dd357a56-93ec-4563-8efa-cc26167b32f6

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Total maintenance labor cost.
	measure 'Labor Cost' = CALCULATE ( SUM ( 'Maintenance Event'[labor_cost] ), 'Maintenance Event'[is_deleted_in_source] = FALSE () )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Maintenance
		lineageTag: 0e51896e-999f-488d-9117-5f47f101f963

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Total maintenance parts cost.
	measure 'Parts Cost' = CALCULATE ( SUM ( 'Maintenance Event'[parts_cost] ), 'Maintenance Event'[is_deleted_in_source] = FALSE () )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Maintenance
		lineageTag: 6413961e-b397-4e36-bb5e-4603f6bfb6dd

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Labor cost plus parts cost.
	measure 'Maintenance Cost' = [Labor Cost] + [Parts Cost]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Maintenance
		lineageTag: f4a6c7cc-d9c1-454b-9c16-6bf38c0af8a4

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Total hours trucks were out of service for maintenance.
	measure 'Downtime Hours' = CALCULATE ( SUM ( 'Maintenance Event'[downtime_hours] ), 'Maintenance Event'[is_deleted_in_source] = FALSE () )
		formatString: #,0.0
		displayFolder: Maintenance
		lineageTag: b9354b77-3c2e-4db4-8673-a0eebb7789ab

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

	/// Maintenance cost divided by actual miles. Answers FE-2.
	measure 'Maintenance Cost per Mile' = DIVIDE ( [Maintenance Cost], [Actual Miles] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Asset Economics
		lineageTag: a7a1037a-efdc-4e12-b791-5afa4ee12d89

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

