/// One row per safety incident, with vehicle and cargo damage cost. 170 incidents in total.
table 'Safety Incident'
	lineageTag: 8066be8a-77f2-489d-8046-4462289771f8
	sourceLineageTag: [fact].[fact_safety_incident]

	/// Count of safety incidents. Always show beside safety rates as the sample size. Answers SA-1.
	measure Incidents = CALCULATE ( COUNTROWS ( 'Safety Incident' ), 'Safety Incident'[is_deleted_in_source] = FALSE () )
		formatString: #,0
		displayFolder: Safety
		lineageTag: 055d55a1-b167-4f97-8e79-6052b0ef3daf

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Vehicle damage cost plus cargo damage cost.
	measure 'Claim Cost' =
			
			CALCULATE (
			    SUM ( 'Safety Incident'[vehicle_damage_cost] ) + SUM ( 'Safety Incident'[cargo_damage_cost] ),
			    'Safety Incident'[is_deleted_in_source] = FALSE ()
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Safety
		lineageTag: 3f7ad9b5-9eeb-41b4-b953-6ff7f2d85543

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Preventable incidents divided by incidents where preventability was recorded.
	measure 'Preventable Rate' =
			
			DIVIDE (
			    CALCULATE ( [Incidents], KEEPFILTERS ( 'Incident Class'[Incident Preventability] = "Preventable" ) ),
			    CALCULATE ( [Incidents], KEEPFILTERS ( 'Incident Class'[Incident Preventability] <> "Not Recorded" ) )
			)
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Safety
		lineageTag: 040434e7-dfb4-425b-afdd-6a918cc2b6bb

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

	/// At-fault incidents divided by incidents where fault was recorded.
	measure 'At-Fault Rate' =
			
			DIVIDE (
			    CALCULATE ( [Incidents], KEEPFILTERS ( 'Incident Class'[Incident Fault Status] = "At Fault" ) ),
			    CALCULATE ( [Incidents], KEEPFILTERS ( 'Incident Class'[Incident Fault Status] <> "Not Recorded" ) )
			)
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Safety
		lineageTag: 991486c2-a92c-4c76-bee5-bec33ea21ca0

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

