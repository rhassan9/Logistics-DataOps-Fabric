/// Shippers who book loads, with account status and payment terms.
table Customer
	lineageTag: 7cdb58e9-35db-4db2-ae4b-8cc113832dce
	sourceLineageTag: [dim].[dim_customer]

	/// Average payment terms in days across the selected customers.
	measure 'Average Credit Terms Days' =
			
			CALCULATE (
			    AVERAGE ( 'Customer'[Credit Terms Days] ),
			    'Customer'[is_current] = TRUE (),
			    'Customer'[customer_key] > 0
			)
		formatString: #,0.0
		displayFolder: Customers
		lineageTag: 1a49ac22-8b40-4a2e-b4d1-26b86b2c310c

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

	column customer_key
		dataType: int64
		isHidden
		isKey
		formatString: 0
		lineageTag: b37f0871-eed9-4be9-ad34-7b0d49de5796
		sourceLineageTag: customer_key
		summarizeBy: none
		sourceColumn: customer_key

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

