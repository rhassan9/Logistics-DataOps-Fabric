/// One row per pickup or delivery stop, with appointment, arrival, arrival variance and detention.
table 'Stop Event'
	lineageTag: 54dd6dd2-6fc6-4f04-bd35-4a2245ffd21f
	sourceLineageTag: [fact].[fact_delivery_event]

	/// Count of delivery stops (pickups excluded). The sample size for on-time measures.
	measure 'Delivery Events' =
			
			CALCULATE (
			    COUNTROWS ( 'Stop Event' ),
			    KEEPFILTERS ( 'Stop Status'[Stop Type] = "Delivery" ),
			    'Stop Event'[is_deleted_in_source] = FALSE ()
			)
		formatString: #,0
		displayFolder: Delivery Performance
		lineageTag: 74350b36-e110-4657-8550-466229b18950

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Delivery stops arriving less than 120 minutes before or after the appointment, measured at full timestamp precision (the source rule).
	measure 'On-Time Deliveries' =
			
			CALCULATE ( [Delivery Events], KEEPFILTERS ( 'Stop Status'[Arrival Status] = "On Time" ) )
		formatString: #,0
		displayFolder: Delivery Performance
		lineageTag: f1f617fc-50ae-46f2-bd36-949516033f22

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Delivery stops arriving 120 minutes or more before the appointment.
	measure 'Early Deliveries' =
			
			CALCULATE ( [Delivery Events], KEEPFILTERS ( 'Stop Status'[Arrival Status] = "Early" ) )
		formatString: #,0
		displayFolder: Delivery Performance
		lineageTag: 8d5bddd7-829c-4e00-9fa0-d7e3389d022d

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Delivery stops arriving 120 minutes or more after the appointment.
	measure 'Late Deliveries' =
			
			CALCULATE ( [Delivery Events], KEEPFILTERS ( 'Stop Status'[Arrival Status] = "Late" ) )
		formatString: #,0
		displayFolder: Delivery Performance
		lineageTag: 32e55ba9-375f-4d90-9846-04cf17f7dddc

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// On-time deliveries divided by delivery events. Answers DP-1.
	measure 'On-Time Rate' = DIVIDE ( [On-Time Deliveries], [Delivery Events] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Delivery Performance
		lineageTag: ae105a6e-831a-483d-9751-ce65e59dcfff

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

	/// Early deliveries divided by delivery events.
	measure 'Early Rate' = DIVIDE ( [Early Deliveries], [Delivery Events] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Delivery Performance
		lineageTag: 8e546642-0329-493a-bf41-c98790cdf512

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

	/// Late deliveries divided by delivery events.
	measure 'Late Rate' = DIVIDE ( [Late Deliveries], [Delivery Events] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Delivery Performance
		lineageTag: dd601072-3169-4cc1-9d9f-dbab620e130b

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

	/// Average minutes between appointment and arrival on deliveries; negative is early, positive is late.
	measure 'Average Arrival Variance Minutes' =
			
			CALCULATE (
			    AVERAGE ( 'Stop Event'[arrival_variance_minutes] ),
			    KEEPFILTERS ( 'Stop Status'[Stop Type] = "Delivery" ),
			    'Stop Event'[is_deleted_in_source] = FALSE ()
			)
		formatString: #,0.0
		displayFolder: Delivery Performance
		lineageTag: f16c19c4-2173-4075-a85b-5808aa2606b1

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

	/// Count of pickup and delivery stops.
	measure 'Stop Events' = CALCULATE ( COUNTROWS ( 'Stop Event' ), 'Stop Event'[is_deleted_in_source] = FALSE () )
		formatString: #,0
		displayFolder: Detention
		lineageTag: 4b7a6d82-4891-45bb-a335-22fa47a437b2

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Average minutes a truck was held at a facility per stop. Answers DP-2.
	measure 'Average Detention Minutes' =
			
			CALCULATE ( AVERAGE ( 'Stop Event'[detention_minutes] ), 'Stop Event'[is_deleted_in_source] = FALSE () )
		formatString: #,0.0
		displayFolder: Detention
		lineageTag: 29c0805d-113a-4341-9aa0-2b3c2fb2d92e

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

	/// Detention minutes beyond the 120-minute free period.
	measure 'Billable Detention Minutes' =
			
			CALCULATE ( SUM ( 'Stop Event'[billable_detention_minutes] ), 'Stop Event'[is_deleted_in_source] = FALSE () )
		formatString: #,0
		displayFolder: Detention
		lineageTag: 7d6c4253-5e42-476d-976a-aebf27cf9328

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Stops where detention exceeded the 120-minute free period.
	measure 'Stops over Free Time' =
			
			CALCULATE ( [Stop Events], KEEPFILTERS ( 'Stop Event'[billable_detention_minutes] > 0 ) )
		formatString: #,0
		displayFolder: Detention
		lineageTag: 476fb97a-ffe1-49c6-809b-462f74fc51d9

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Stops with any detention as a share of all stops.
	measure 'Share of Stops with Detention' =
			
			DIVIDE ( CALCULATE ( [Stop Events], KEEPFILTERS ( 'Stop Event'[detention_minutes] > 0 ) ), [Stop Events] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Detention
		lineageTag: 841d173b-8186-49c3-9ebe-acea330b860c

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

