/// One row per fuel purchase, with gallons and cost.
table 'Fuel Purchase'
	lineageTag: 2fb1550a-65fc-486a-858f-f1819ed362ec
	sourceLineageTag: [fact].[fact_fuel_purchase]

	/// Total amount paid for fuel purchases.
	measure 'Fuel Cost' = CALCULATE ( SUM ( 'Fuel Purchase'[total_cost] ), 'Fuel Purchase'[is_deleted_in_source] = FALSE () )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Fuel
		lineageTag: 82ea441b-6e68-4538-8450-cce434484078

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Total gallons bought in fuel purchases.
	measure 'Gallons Purchased' = CALCULATE ( SUM ( 'Fuel Purchase'[gallons] ), 'Fuel Purchase'[is_deleted_in_source] = FALSE () )
		formatString: #,0.0
		displayFolder: Fuel
		lineageTag: 907b6285-f975-4348-a11e-b23b3388403e

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

	/// Fuel cost divided by gallons purchased (weighted by gallons). Answers FU-1.
	measure 'Average Price per Gallon' = DIVIDE ( [Fuel Cost], [Gallons Purchased] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Fuel
		lineageTag: fb9f39be-6897-48e0-8bc3-2d2934037b3f

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Lowest price per gallon paid on any single fuel purchase.
	measure 'Lowest Price Paid' =
			
			MINX (
			    FILTER ( 'Fuel Purchase', 'Fuel Purchase'[is_deleted_in_source] = FALSE () && 'Fuel Purchase'[gallons] > 0 ),
			    DIVIDE ( 'Fuel Purchase'[total_cost], 'Fuel Purchase'[gallons] )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Fuel
		lineageTag: 2452fba7-b923-42a9-bf7f-9403aae7e623

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Highest price per gallon paid on any single fuel purchase.
	measure 'Highest Price Paid' =
			
			MAXX (
			    FILTER ( 'Fuel Purchase', 'Fuel Purchase'[is_deleted_in_source] = FALSE () && 'Fuel Purchase'[gallons] > 0 ),
			    DIVIDE ( 'Fuel Purchase'[total_cost], 'Fuel Purchase'[gallons] )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Fuel
		lineageTag: 56ab6d07-9c83-4880-9055-5da7944ac791

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Fuel cost in the selected location as a share of fuel cost across all locations.
	measure 'Share of Fuel Spend' = DIVIDE ( [Fuel Cost], CALCULATE ( [Fuel Cost], ALL ( 'Location' ) ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Fuel
		lineageTag: 2aa953f2-5dd6-4d80-b2b5-23840e5d89a1

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

	/// Fuel cost divided by actual miles.
	measure 'Fuel Cost per Mile' = DIVIDE ( [Fuel Cost], [Actual Miles] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Route Contribution
		lineageTag: 4f130362-02ec-457f-893b-dd2daa836704

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

