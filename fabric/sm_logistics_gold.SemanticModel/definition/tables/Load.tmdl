/// One row per load from booking to delivery. Holds charges; its truck, driver and trailer are the ones that fulfilled the load.
table Load
	lineageTag: 1285a261-7f2d-4308-bd92-6ea0d0dee3c4
	sourceLineageTag: [fact].[fact_load_lifecycle]

	/// Count of loads, excluding loads deleted at the source.
	measure Loads = CALCULATE ( COUNTROWS ( 'Load' ), 'Load'[is_deleted_in_source] = FALSE () )
		formatString: #,0
		displayFolder: Route Contribution
		lineageTag: 69310547-a344-4301-9641-e5c32d23ee3b

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Line-haul revenue as recorded at the source; excludes fuel surcharge and accessorial charges.
	measure 'Line-Haul Revenue' = CALCULATE ( SUM ( 'Load'[revenue] ), 'Load'[is_deleted_in_source] = FALSE () )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Route Contribution
		lineageTag: 87c8678f-dd95-4d03-895e-0aef78c58e89

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Fuel surcharge billed on loads.
	measure 'Fuel Surcharge' = CALCULATE ( SUM ( 'Load'[fuel_surcharge] ), 'Load'[is_deleted_in_source] = FALSE () )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Route Contribution
		lineageTag: 9d140e45-edc3-4bae-b119-f4fe66cfa170

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Accessorial charges billed on loads, as recorded at the source.
	measure 'Accessorial Charges' = CALCULATE ( SUM ( 'Load'[accessorial_charges] ), 'Load'[is_deleted_in_source] = FALSE () )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Route Contribution
		lineageTag: 66c36682-2d6d-434d-b7ba-248bdfc9a15c

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Line-haul revenue plus fuel surcharge plus accessorial charges: everything billed for loads.
	measure 'Total Charges' = [Line-Haul Revenue] + [Fuel Surcharge] + [Accessorial Charges]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Route Contribution
		lineageTag: 0f8635e8-cc6c-4626-8189-32c83783d5a3

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Total charges minus fuel cost. Not profit or margin: the data has no driver pay, depreciation or overhead. Answers FE-1.
	measure 'Contribution after Fuel' = [Total Charges] - [Fuel Cost]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Route Contribution
		lineageTag: 80ca3426-d8e1-4a85-8ae3-07cf17b7a756

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Line-haul revenue divided by actual miles.
	measure 'Line-Haul Revenue per Mile' = DIVIDE ( [Line-Haul Revenue], [Actual Miles] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Route Contribution
		lineageTag: fd03aebc-4ca2-4792-8f5d-0478916852ea

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Line-haul revenue divided by active trucks. Revenue is credited to the truck that fulfilled the load. Answers FE-2.
	measure 'Line-Haul Revenue per Active Truck' = DIVIDE ( [Line-Haul Revenue], [Active Trucks] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Asset Economics
		lineageTag: 196917e7-d2ed-4d36-858d-4f5f4973a14c

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Actual miles divided by active trucks.
	measure 'Miles per Active Truck' = DIVIDE ( [Actual Miles], [Active Trucks] )
		formatString: #,0
		displayFolder: Asset Economics
		lineageTag: 1ca7a2ed-4ad6-4917-ad6a-3844e1ef524f

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Loads divided by active trucks.
	measure 'Loads per Active Truck' = DIVIDE ( [Loads], [Active Trucks] )
		formatString: " #,0.0"
		displayFolder: Asset Economics
		lineageTag: 789e0495-a99b-4261-9dc2-24e5ac1e7f8d

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = FormatStringDefinition

		annotation PBI_FormatHint = {"isCustom":true}

	/// Line-haul revenue divided by loads. Answers CR-1.
	measure 'Line-Haul Revenue per Load' = DIVIDE ( [Line-Haul Revenue], [Loads] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Customers
		lineageTag: 1ab1714f-bc58-4160-bcaf-c399fdccce32

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Line-haul revenue for the selected customers as a share of all customers.
	measure 'Share of Line-Haul Revenue' = DIVIDE ( [Line-Haul Revenue], CALCULATE ( [Line-Haul Revenue], ALL ( 'Customer' ) ) )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Customers
		lineageTag: 38311977-f72b-4aef-b136-bbc37ad14a2e

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

