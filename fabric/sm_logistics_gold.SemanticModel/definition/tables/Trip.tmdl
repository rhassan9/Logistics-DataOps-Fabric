/// One row per trip, an execution attempt of a load. Holds miles, duration, fuel used and idle time.
table Trip
	lineageTag: ac3073a6-a395-4abe-be0f-1404f81e5fcf
	sourceLineageTag: [fact].[fact_trip]

	/// Count of trips, one per execution attempt of a load. Excludes trips deleted at the source.
	measure Trips = CALCULATE ( COUNTROWS ( 'Trip' ), 'Trip'[is_deleted_in_source] = FALSE () )
		formatString: #,0
		displayFolder: Utilization
		lineageTag: 27d17355-2f22-414b-9f73-50b4283386fa

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Total distance driven on trips, in miles.
	measure 'Actual Miles' = CALCULATE ( SUM ( 'Trip'[actual_distance_miles] ), 'Trip'[is_deleted_in_source] = FALSE () )
		formatString: #,0
		displayFolder: Route Contribution
		lineageTag: 153217c5-847f-4274-9b5a-ab55f3bff279

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Fuel consumed on trips, in gallons, as recorded on each trip.
	measure 'Trip Fuel Gallons' = CALCULATE ( SUM ( 'Trip'[fuel_gallons_used] ), 'Trip'[is_deleted_in_source] = FALSE () )
		formatString: #,0.0
		displayFolder: Utilization
		lineageTag: 292e2ba0-2f9b-4db7-8c5f-e2c790e3742b

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

	/// Total engine idle hours on trips. Valid as a total, not as a share of trip duration.
	measure 'Idle Hours' = CALCULATE ( SUM ( 'Trip'[idle_time_hours] ), 'Trip'[is_deleted_in_source] = FALSE () )
		formatString: #,0.0
		displayFolder: Utilization
		lineageTag: 3fbadf05-f8d9-423d-93f9-58ca131440c0

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

	/// Number of distinct days with at least one trip dispatched.
	measure 'Active Days' = CALCULATE ( DISTINCTCOUNT ( 'Trip'[dispatch_date_key] ), 'Trip'[is_deleted_in_source] = FALSE () )
		formatString: #,0
		displayFolder: Utilization
		lineageTag: a1c27bd6-78b8-45f1-9c40-38e858127089

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Trucks with at least one trip in the selection, each counted once regardless of version.
	measure 'Active Trucks' =
			
			CALCULATE (
			    DISTINCTCOUNT ( 'Truck'[Truck ID] ),
			    CALCULATETABLE ( 'Trip', 'Trip'[is_deleted_in_source] = FALSE () ),
			    'Truck'[truck_key] > 0
			)
		formatString: #,0
		displayFolder: Utilization
		lineageTag: 6b765848-cb36-4085-b64d-a0425d9f7323

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Drivers with at least one trip in the selection, each counted once regardless of version.
	measure 'Active Drivers' =
			
			CALCULATE (
			    DISTINCTCOUNT ( 'Driver'[Driver ID] ),
			    CALCULATETABLE ( 'Trip', 'Trip'[is_deleted_in_source] = FALSE () ),
			    'Driver'[driver_key] > 0
			)
		formatString: #,0
		displayFolder: Utilization
		lineageTag: ae1814d8-cef2-4e4c-9ce1-0c1ab13f1d96

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Active drivers divided by active trucks. Answers UT-1.
	measure 'Drivers per Truck' = DIVIDE ( [Active Drivers], [Active Trucks] )
		formatString: #,0.0
		displayFolder: Utilization
		lineageTag: ece84a1d-8691-4fbb-967b-4c17d66ac794

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

	/// Trips divided by active trucks. Answers UT-1.
	measure 'Trips per Active Truck' = DIVIDE ( [Trips], [Active Trucks] )
		formatString: #,0.0
		displayFolder: Utilization
		lineageTag: f3cecf66-856d-490e-80b1-82b2189b6102

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

		annotation PBI_FormatHint = {"isCustom":true}

	/// Trip fuel gallons divided by actual miles. Fleet and truck level only; blank when filtered by driver because per-driver fuel efficiency isn't supported by the data.
	measure 'Gallons per Mile' =
			
			IF ( ISFILTERED ( 'Driver' ), BLANK (), DIVIDE ( [Trip Fuel Gallons], [Actual Miles] ) )
		formatString: 0.000
		displayFolder: Utilization
		lineageTag: e0f543e9-c383-42c9-a231-0c2cf4331cbe

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

